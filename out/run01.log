== 数据库表结构 ==
-- probes  (1 行)
CREATE TABLE probes (
                        probe_id INTEGER PRIMARY KEY,
                        probe_type TEXT NOT NULL,
                        serial_number TEXT NOT NULL,
                        created_at TEXT NOT NULL,
                        UNIQUE(probe_type, serial_number)
                    )
-- calibrations  (2 行)
CREATE TABLE calibrations (
                        calibration_id INTEGER PRIMARY KEY,
                        probe_id INTEGER NOT NULL,
                        calibration_date TEXT,
                        calibration_paths TEXT,
                        info TEXT,
                        wavelengths TEXT,
                        start_index INTEGER,
                        dn_num INTEGER,
                        physical_quantity TEXT,
                        unit TEXT,
                        is_active BOOLEAN DEFAULT 1,
                        FOREIGN KEY (probe_id) REFERENCES probes (probe_id) ON DELETE CASCADE
                    )
-- raw_data  (0 行)
CREATE TABLE raw_data (
                        raw_data_id INTEGER PRIMARY KEY,
                        raw_content BLOB
                    )
-- spectra_dn  (10185 行)
CREATE TABLE spectra_dn (
                        spectra_dn_id INTEGER PRIMARY KEY,
                        calibration_id INTEGER NOT NULL,
                        integration_time_ms REAL,
                        dn_capture_mode TEXT,
                        dn_values TEXT NOT NULL,
                        FOREIGN KEY (calibration_id) REFERENCES calibrations (calibration_id)
                    )
-- spectra_phy  (10185 行)
CREATE TABLE spectra_phy (
                        spectra_phy_id INTEGER PRIMARY KEY,
                        calibration_id INTEGER NOT NULL,
                        integration_time_ms REAL,
                        phy_values TEXT NOT NULL,
                        FOREIGN KEY (calibration_id) REFERENCES calibrations (calibration_id)
                    )
-- capture_batches  (10197 行)
CREATE TABLE capture_batches (
                        batch_id INTEGER PRIMARY KEY,
                        timestamp TEXT NOT NULL
                    )
-- captures  (10185 行)
CREATE TABLE captures (
                        capture_id INTEGER PRIMARY KEY,
                        probe_id INTEGER NOT NULL,
                        capture_batch_id INTEGER,
                        timestamp TEXT NOT NULL,
                        raw_data_id INTEGER,
                        spectra_dn_id INTEGER,
                        spectra_phy_id INTEGER,
                        FOREIGN KEY (probe_id) REFERENCES probes (probe_id) ON DELETE CASCADE,
                        FOREIGN KEY (raw_data_id) REFERENCES raw_data (raw_data_id) ON DELETE SET NULL,
                        FOREIGN KEY (spectra_dn_id) REFERENCES spectra_dn (spectra_dn_id) ON DELETE SET NULL,
                        FOREIGN KEY (spectra_phy_id) REFERENCES spectra_phy (spectra_phy_id) ON DELETE SET NULL,
                        FOREIGN KEY (capture_batch_id) REFERENCES capture_batches (batch_id) ON DELETE SET NULL
                    )

